# Postgres — a free Neon database works (neon.tech, no card)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Groq — free tier, https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Telegram — from @BotFather
TELEGRAM_BOT_TOKEN=
# Any random string; set the same value when registering the webhook
TELEGRAM_WEBHOOK_SECRET=

# OPTIONAL. Unset = everything still works, free.
# Only needed for photo calorie estimation and richer weekly reports.
ANTHROPIC_API_KEY=
